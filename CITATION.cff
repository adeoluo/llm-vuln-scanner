    given-names: "Adeolu"
version: 0.1.0
date-released: 2026-11-08
license: MIT
repository-code: "https://github.com/adeoluo/llm-vuln-scanner"
url: "https://github.com/adeoluo/llm-vuln-scanner"
keywords:
